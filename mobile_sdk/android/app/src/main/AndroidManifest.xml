<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lapang.emergency.sdk">
    
    <!-- Geofencing & Background Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    
    <!-- Lockscreen Bypass, Heads-up popup, & Siren Overlays Rights -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Android 13+ Notification Runtime Permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

   <application
        android:label="LAPANG Emergency Client"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">
            
            <!-- Launch configurations -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <!-- Background execution metadata for Flutter -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
            
        <!-- Custom high importance notification channel for Lockscreen takeover -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="lapang_emergency_channel" />
            
    </application>
</manifest>
